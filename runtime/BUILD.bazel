load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":helpers_test.bzl", "helpers_test_suite")

package(default_visibility = ["//visibility:public"])

exports_files(["helpers.bzl"])

bzl_library(
    name = "helpers",
    srcs = ["helpers.bzl"],
)

