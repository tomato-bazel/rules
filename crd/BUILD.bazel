load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//crd:toolchains.bzl", "k8s_crd_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "providers.bzl",
    "toolchains.bzl",
])

# The CRD codegen toolchain type. One type, not one per language: controller-gen
# reads Go and only Go. If a Rust CRD generator ever exists, it would want its own
# type rather than an implementation of this one, because the inputs differ.
toolchain_type(name = "toolchain_type")

# The default implementation. Consumers get it by registering it in .bazelrc:
#
#   common --extra_toolchains=@rules_k8s//crd:default_k8s_crd_toolchain
#
# NOT via register_toolchains() in MODULE.bazel — that would propagate into every
# consumer, dragging a Go SDK onto consumers that only read schemas.
k8s_crd_toolchain(
    name = "default_k8s_crd_toolchain_impl",
    driver = "//crd/private/driver",
    gen = "//crd/private/gen",
)

toolchain(
    name = "default_k8s_crd_toolchain",
    toolchain = ":default_k8s_crd_toolchain_impl",
    toolchain_type = ":toolchain_type",
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        ":providers",
        ":toolchains",
        "//crd/private:crd_library",
    ],
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
)

bzl_library(
    name = "toolchains",
    srcs = ["toolchains.bzl"],
)
