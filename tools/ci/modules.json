{
  "_comment": "Optional per-module CI overrides. Default bazel command is 'test //... --test_output=errors'. Exit 4 falls back to build //.... Source HEAD of some first-cluster modules cannot analyze or pass every target the original ci.yml asked for; overrides stay in this file so we do not rewrite imported MODULE.bazel / docs.",
  "rules_github": {
    "bazel": "build //..."
  },
  "rules_jena": {
    "bazel": "test //jena/... --test_output=errors"
  },
  "rules_ci": {
    "bazel": "",
    "extra": [
      {
        "cmd": "cargo test --workspace",
        "workdir": "translator"
      }
    ]
  },
  "rules_tomato": {
    "noworkspace_rc": true
  },
  "rules_markdown": {
    "bazel": "test //examples/... --test_output=errors"
  },
  "rules_mdbook": {
    "bazel": "test //docs/... //examples/... --test_output=errors"
  },
  "rules_readme": {
    "bazel": "test //examples/... --test_output=errors"
  },
  "rules_openapi": {
    "bazel": "",
    "setup_go": true,
    "extra": [
      {
        "cmd": "go test ./tools/openapi_to_go_client/",
        "workdir": "."
      }
    ]
  },
  "rules_bun": {
    "bazel": "test //docs/... --test_output=errors"
  },
  "rules_nextjs": {
    "bazel": "build //next/..."
  },
  "rules_vite": {
    "bazel": "test //docs/... --test_output=errors"
  },
  "rules_astro": {
    "bazel": ""
  },
  "rules_storybook": {
    "bazel": "build //..."
  },
  "rules_chrome": {
    "bazel": "test //docs/... --test_output=errors"
  },
  "rules_docker_compose": {
    "bazel": "test //compose/... //examples/... --test_output=errors"
  },
  "rules_lean": {
    "bazel": "test //docs/... --test_output=errors"
  },
  "rules_lang": {
    "bazel": "test //docs/... --test_output=errors"
  },
  "rules_postgres": {
    "bazel": "test //docs/... //examples/... --test_output=errors"
  },
  "rules_uv": {
    "bazel": "test //docs/... --test_output=errors"
  }
}
