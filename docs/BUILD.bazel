load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")

package(default_visibility = ["//visibility:public"])

# Reference docs are stardoc-generated *and* committed. The diff_test asserts the
# committed defs.md matches what stardoc produces; CI fails if readme()'s
# docstring changes without `bazel run //docs:update`.

stardoc(
    name = "defs_doc",
    out = "defs.md.generated",
    input = "//readme:defs.bzl",
    deps = ["//readme:defs_bzl"],
)

diff_test(
    name = "defs_doc_up_to_date",
    file1 = "defs.md",
    file2 = ":defs_doc",
)

sh_binary(
    name = "update",
    srcs = ["update.sh"],
    data = [":defs_doc"],
)
