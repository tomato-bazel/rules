# Copilot skill projection — the *shim* shape (Forge "link, don't
# duplicate"). The canonical body stays in .agents/; Copilot gets a thin
# .github/agents/<name>.md carrying a `description` frontmatter (for agent
# discovery) over a one-line pointer to the canonical file, never the real
# content.
PREFIX aide: <https://fastverk.dev/ontology/agentic_ide/projection#>

CONSTRUCT {
    ?out a aide:OutputFile ;
        aide:targetPath ?path ;
        aide:fileFormat aide:MarkdownYaml ;
        aide:forIde aide:Copilot ;
        aide:fromDef ?skill ;
        aide:bodyInline ?redirect ;
        aide:frontmatter ?descFm .
    ?descFm aide:key "description" ; aide:value ?desc ; aide:order 0 .
}
WHERE {
    ?skill a aide:Skill ;
        aide:defName ?name ;
        aide:bodyPath ?body .
    OPTIONAL { ?skill aide:description ?desc }
    BIND(IRI(CONCAT("https://fastverk.dev/ontology/agentic_ide/projection#out/copilot/skill/", ?name)) AS ?out)
    BIND(CONCAT(".github/agents/", ?name, ".md") AS ?path)
    BIND(CONCAT("This agent is defined canonically in `", ?body, "`. Edit that file — this shim is generated by `agentic-ide generate`.") AS ?redirect)
    BIND(IRI(CONCAT("https://fastverk.dev/ontology/agentic_ide/projection#out/copilot/skill/", ?name, "/fm/desc")) AS ?descFm)
}
