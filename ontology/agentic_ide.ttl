@prefix aide:    <https://fastverk.dev/ontology/agentic_ide/projection#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#
# agentic-ide projection ontology (aide:)
# =======================================
#
# Public. The `aide:` vocabulary is the *forward* direction: authored
# definition resources (a Skill, an MCP server, a Ruleset, …) that project
# into per-IDE config files. This is the semantic-web realization of
# Forge's "fully normalized knowledge resources" doctrine — the graph is
# the one authoritative location; IDE config files are materialized views.
#
# Authored definitions (typically in a consumer repo's .agents/graph/*.ttl)
# carry frontmatter + a content-addressed body reference + links to other
# files/targets. Per-IDE CONSTRUCT queries reshape them into the generic
# `aide:OutputFile` "filespec" shape, which the Rust serializer turns into
# actual files. Bodies are stored by reference (aide:bodyPath / aide:bodyBlob)
# rather than inlined, so large markdown bodies stay out of the graph and
# content-addressing ties into git's object graph.
#
# This is the public projection vocabulary, split out of the private
# agentic-ide harvest ontology (the chat: vocab). The only coupling severed
# in the split is the body/link blob reference, which now ranges over a
# self-contained aide:Blob rather than the private chat:Blob.
#

<https://fastverk.dev/ontology/agentic_ide/projection>
    a owl:Ontology ;
    dcterms:title "Agentic IDE projection ontology" ;
    dcterms:description
        "The forward/authoring vocabulary (aide:) for projecting a single normalized knowledge graph into per-IDE agent-config files — skills, subagents, slash commands, rulesets, MCP config, settings, hooks — across Claude Code, GitHub Copilot, and Cursor. Authored definitions reshape, via per-IDE CONSTRUCT queries, into the generic aide:OutputFile filespec the serializer materializes." ;
    owl:versionInfo "0.0.1" .

# ---- Content-addressed blob (self-contained; severs the chat: coupling) ----

aide:Blob
    a owl:Class ;
    rdfs:label "Content-addressed blob" ;
    rdfs:comment
        "A file body or linked file referenced by content address rather than inlined. aide:cid is the content hash (e.g. a git blob oid or BLAKE3 hex), so bodies stay out of the graph and tie into git's object graph." .

aide:cid a owl:DatatypeProperty ; rdfs:domain aide:Blob ; rdfs:range xsd:string .

# ---- Authored definition resources ----

aide:Definition
    a owl:Class ;
    rdfs:label "Agent config definition" ;
    rdfs:comment "Abstract base for an authored, IDE-agnostic agent-config resource that projects into one or more per-IDE files." .

aide:Skill      a owl:Class ; rdfs:subClassOf aide:Definition ; rdfs:label "Skill" .
aide:Agent      a owl:Class ; rdfs:subClassOf aide:Definition ; rdfs:label "Subagent definition" .
aide:Command    a owl:Class ; rdfs:subClassOf aide:Definition ; rdfs:label "Slash command / prompt" .
aide:Ruleset    a owl:Class ; rdfs:subClassOf aide:Definition ; rdfs:label "Ruleset (CLAUDE.md / AGENTS.md / .cursorrules / copilot-instructions)" .
aide:McpServer  a owl:Class ; rdfs:subClassOf aide:Definition ; rdfs:label "MCP server definition" .
aide:Hook       a owl:Class ; rdfs:subClassOf aide:Definition ; rdfs:label "Hook" .
aide:Settings   a owl:Class ; rdfs:subClassOf aide:Definition ; rdfs:label "Settings / permissions" .

aide:Bundle
    a owl:Class ;
    rdfs:label "Per-IDE projection bundle" ;
    rdfs:comment "A set of definitions projected together for one target IDE." .

# ---- Enumerated individuals (scope / flavor / transport / format / ide) ----

aide:Scope      a owl:Class ; rdfs:label "Ruleset scope" .
aide:Global       a aide:Scope .
aide:Project      a aide:Scope .
aide:FilePattern  a aide:Scope .
aide:Subagent     a aide:Scope .

aide:McpFlavor  a owl:Class ; rdfs:label "MCP server flavor" .
aide:Network      a aide:McpFlavor ; rdfs:comment "External network service (url + headers)." .
aide:Binary       a aide:McpFlavor ; rdfs:comment "External binary (command + args + env)." .
aide:BazelTarget  a aide:McpFlavor ; rdfs:comment "Hermetic server backed by an upstream bazel target." .

aide:Transport  a owl:Class ; rdfs:label "MCP transport" .
aide:Stdio        a aide:Transport .
aide:Http         a aide:Transport .
aide:Sse          a aide:Transport .

aide:FileFormat a owl:Class ; rdfs:label "Output file serialization" .
aide:MarkdownYaml a aide:FileFormat ; rdfs:comment "Markdown body with a YAML frontmatter block." .
aide:Json         a aide:FileFormat .
aide:Mdc          a aide:FileFormat ; rdfs:comment "Cursor .mdc (frontmatter + body)." .

aide:Ide        a owl:Class ; rdfs:label "Target agentic IDE" .
aide:ClaudeCode   a aide:Ide .
aide:Copilot      a aide:Ide .
aide:Cursor       a aide:Ide .

# ---- Common definition properties ----

aide:defName      a owl:DatatypeProperty ; rdfs:domain aide:Definition ; rdfs:range xsd:string ;
    rdfs:comment "Short kebab-case identifier; the AIP resource id and the basis for projected file names." .
aide:description  a owl:DatatypeProperty ; rdfs:domain aide:Definition ; rdfs:range xsd:string .
aide:scope        a owl:ObjectProperty  ; rdfs:domain aide:Definition ; rdfs:range aide:Scope .
aide:glob         a owl:DatatypeProperty ; rdfs:domain aide:Definition ; rdfs:range xsd:string ;
    rdfs:comment "File-pattern glob, when scope is aide:FilePattern (Cursor globs / Copilot applyTo)." .
aide:subagentName a owl:DatatypeProperty ; rdfs:domain aide:Agent ;      rdfs:range xsd:string .

# Body storage: by reference, not inlined. bodyPath is the checked-in
# markdown path; bodyBlob is the content-address (aide:Blob / aide:cid).
# bodyInline is for tiny shims (e.g. a Copilot redirect).
aide:bodyPath     a owl:DatatypeProperty ; rdfs:domain aide:Definition ; rdfs:range xsd:string .
aide:bodyBlob     a owl:ObjectProperty  ; rdfs:domain aide:Definition ; rdfs:range aide:Blob .
aide:bodyInline   a owl:DatatypeProperty ; rdfs:domain aide:Definition ; rdfs:range xsd:string .

# Cross-references — the "linked files" that motivate the graph model.
aide:linksFile    a owl:ObjectProperty  ; rdfs:domain aide:Definition ; rdfs:range aide:Blob ;
    rdfs:comment "A repo file the body references; resolves to its git blob so dangling links fail a gate." .
aide:linksTarget  a owl:DatatypeProperty ; rdfs:domain aide:Definition ; rdfs:range xsd:string ;
    rdfs:comment "A bazel target label the definition references (e.g. an MCP bazel-flavor server)." .

# ---- Ordered key/value entries (frontmatter, env, headers, args) ----

aide:Entry      a owl:Class ; rdfs:label "Ordered key/value entry" .
aide:key        a owl:DatatypeProperty ; rdfs:domain aide:Entry ; rdfs:range xsd:string .
aide:value      a owl:DatatypeProperty ; rdfs:domain aide:Entry ; rdfs:range xsd:string .
aide:order      a owl:DatatypeProperty ; rdfs:domain aide:Entry ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Stable ordering key so projected YAML/JSON/arg order is deterministic (clean diffs)." .

aide:frontmatter a owl:ObjectProperty ; rdfs:range aide:Entry ;
    rdfs:comment "Definition or OutputFile → an ordered frontmatter entry." .

# Structured frontmatter: an aide:Entry is scalar (aide:value), a list
# (ordered aide:listItem entries, each with aide:value + aide:order), or
# a map (ordered aide:subEntry entries). Real IDE configs nest — e.g. a
# skill's `metadata: { allowed_tools: [read_file, …] }`.
aide:listItem a owl:ObjectProperty ; rdfs:domain aide:Entry ; rdfs:range aide:Entry ;
    rdfs:comment "An ordered list item (an aide:Entry carrying aide:value + aide:order)." .
aide:subEntry a owl:ObjectProperty ; rdfs:domain aide:Entry ; rdfs:range aide:Entry ;
    rdfs:comment "A nested map entry (an aide:Entry), for nested-object frontmatter." .

# ---- MCP server properties ----

aide:mcpFlavor  a owl:ObjectProperty  ; rdfs:domain aide:McpServer ; rdfs:range aide:McpFlavor .
aide:transport  a owl:ObjectProperty  ; rdfs:domain aide:McpServer ; rdfs:range aide:Transport .
aide:command    a owl:DatatypeProperty ; rdfs:domain aide:McpServer ; rdfs:range xsd:string .
aide:arg        a owl:ObjectProperty  ; rdfs:domain aide:McpServer ; rdfs:range aide:Entry ;
    rdfs:comment "An ordered command argument (aide:value carries the arg; aide:order its position)." .
aide:envVar     a owl:ObjectProperty  ; rdfs:domain aide:McpServer ; rdfs:range aide:Entry .
aide:url        a owl:DatatypeProperty ; rdfs:domain aide:McpServer ; rdfs:range xsd:string .
aide:header     a owl:ObjectProperty  ; rdfs:domain aide:McpServer ; rdfs:range aide:Entry .
aide:bazelLabel a owl:DatatypeProperty ; rdfs:domain aide:McpServer ; rdfs:range xsd:string .

# ---- Settings / hooks ----

aide:permissionAllow    a owl:DatatypeProperty ; rdfs:domain aide:Settings ; rdfs:range xsd:string .
aide:additionalDirectory a owl:DatatypeProperty ; rdfs:domain aide:Settings ; rdfs:range xsd:string .
aide:hookEvent   a owl:DatatypeProperty ; rdfs:domain aide:Hook ; rdfs:range xsd:string .
aide:hookCommand a owl:DatatypeProperty ; rdfs:domain aide:Hook ; rdfs:range xsd:string .

# ---- Bundle ----

aide:targetIde     a owl:ObjectProperty ; rdfs:domain aide:Bundle ; rdfs:range aide:Ide .
aide:bundleMember  a owl:ObjectProperty ; rdfs:domain aide:Bundle ; rdfs:range aide:Definition .

# ---- Filespec (the CONSTRUCT output the serializer consumes) ----

aide:OutputFile
    a owl:Class ;
    rdfs:label "Projected output file" ;
    rdfs:comment "The generic, file-shaped target of a per-IDE projection CONSTRUCT. The serializer branches only on aide:fileFormat — never on the originating definition type." .

aide:targetPath  a owl:DatatypeProperty ; rdfs:domain aide:OutputFile ; rdfs:range xsd:string ;
    rdfs:comment "Repo-relative path to write (e.g. .claude/skills/<name>/SKILL.md)." .
aide:fileFormat  a owl:ObjectProperty  ; rdfs:domain aide:OutputFile ; rdfs:range aide:FileFormat .
aide:forIde      a owl:ObjectProperty  ; rdfs:domain aide:OutputFile ; rdfs:range aide:Ide .
aide:fromDef     a owl:ObjectProperty  ; rdfs:domain aide:OutputFile ; rdfs:range aide:Definition ;
    rdfs:comment "Provenance: the authored definition this file was projected from." .

# JSON / MCP-config output shape. Unlike markdown files (frontmatter +
# body), a .mcp.json aggregates N MCP servers into one structured file,
# so the projection attaches each server as an aide:mcpEntry on a single
# aide:OutputFile and the serializer builds the JSON per flavor.
aide:JsonShape a owl:Class ; rdfs:label "Structured JSON output shape" .
aide:McpConfig a aide:JsonShape ;
    rdfs:comment "An MCP server config file (.mcp.json / .vscode/mcp.json / .cursor/mcp.json)." .

aide:jsonShape a owl:ObjectProperty ; rdfs:domain aide:OutputFile ; rdfs:range aide:JsonShape ;
    rdfs:comment "For an aide:Json file, the structured shape the serializer builds (vs. a free-form body)." .
aide:mcpEntry  a owl:ObjectProperty ; rdfs:domain aide:OutputFile ;
    rdfs:comment "An MCP server entry aggregated into a single .mcp.json OutputFile. Entry nodes carry aide:serverName + the aide:mcpFlavor/transport/command/arg/envVar/url/header/bazelLabel of the server." .
aide:serverName a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The MCP server's key in the generated JSON's mcpServers map." .
