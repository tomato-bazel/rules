# Shared fastverk Bazel config. Consume it from a repo's own .bazelrc with:
#
#     try-import %workspace%/tools/fastverk.bazelrc   # vendored copy, or
#     import     <path to this file>
#
# (or paste these lines). Keeping it here stops the registry-chain + flag drift
# the BOM/ratchet is fixing. The `rels deps` ratchet also syncs this into each
# repo.

common --enable_bzlmod
common --experimental_isolated_extension_usages

# The fastverk registry chain (constellation modules + BCR).
common --registry=https://registry.fastverk.com/
common --registry=https://bcr.bazel.build/

# Private fastverk module sources resolve via the credential helper.
common --credential_helper=%workspace%/tools/credhelper/fastverk-cred-helper
common --repo_env=GITHUB_TOKEN
common --repo_env=GH_TOKEN

test --test_output=errors
test --test_summary=terse
