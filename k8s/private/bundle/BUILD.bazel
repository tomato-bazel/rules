load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# gazelle:ignore

go_library(
    name = "bundle_lib",
    srcs = ["main.go"],
    importpath = "github.com/tomato-bazel/rules_k8s/k8s/private/bundle",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/params",
        # apimachinery's YAMLReader — the splitter kubectl applies with. See
        # splitDocs in main.go for why a hand-rolled one was wrong.
        "@io_k8s_apimachinery//pkg/util/yaml",
        "@io_k8s_sigs_yaml//:yaml",
    ],
)

go_binary(
    name = "bundle",
    embed = [":bundle_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "bundle_test",
    srcs = ["bundle_test.go"],
    embed = [":bundle_lib"],
)
