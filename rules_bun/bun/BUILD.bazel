load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

toolchain_type(name = "toolchain_type")

exports_files([
    "defs.bzl",
    "extensions.bzl",
    "toolchains.bzl",
    "bun-build-driver.mjs",
])

# The shared `bun build` driver for `bun_bundle` / `bun_compile`, wrapped as a
# js_library so a consumer package's `driver` js_binary can reference it as a
# cross-package `entry_point`. aspect_rules_js requires entry-point sources that
# live outside the binary's own package to be copied to bin via a js_library.
js_library(
    name = "bun-build-driver",
    srcs = ["bun-build-driver.mjs"],
)

bzl_library(
    name = "defs_bzl",
    srcs = ["defs.bzl"],
    visibility = ["//docs:__pkg__"],
    deps = ["@rules_shell//shell:rules_bzl"],
)

bzl_library(
    name = "extensions_bzl",
    srcs = ["extensions.bzl"],
    visibility = ["//docs:__pkg__"],
    deps = [
        "//bun/private:install_bzl",
        "//bun/private:known_versions_bzl",
        "@rules_github//github:repositories_bzl",
    ],
)

bzl_library(
    name = "toolchains_bzl",
    srcs = ["toolchains.bzl"],
    visibility = ["//docs:__pkg__"],
)
