"""ssh-tui-server — the russh-based SSH front-end.

Downstream consumers don't reference this binary directly; they use
the `ssh_tui_image` macro in //ssh_tui:defs.bzl, which pulls the
server in alongside the caller's login_binary.
"""

load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@ssh_tui_crates//:defs.bzl", "all_crate_deps")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "ssh-tui-server",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = all_crate_deps(normal = True, package_name = "server"),
    # async-trait + tracing's value-fmt internals are proc-macros and
    # have to be threaded via proc_macro_deps, not the regular deps
    # list, for rules_rust to wire them into rustc's --extern paths.
    proc_macro_deps = all_crate_deps(proc_macro = True, package_name = "server"),
)

exports_files(["Cargo.toml"])
