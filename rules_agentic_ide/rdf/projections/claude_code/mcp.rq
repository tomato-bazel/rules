# Claude Code MCP projection.
#
# Every authored aide:McpServer projects into a single .mcp.json — so
# all servers attach (via aide:mcpEntry) to ONE aide:OutputFile with a
# fixed IRI, each carrying its flavor/transport/command/args/env/url/
# headers. The serializer's McpConfig path builds the per-flavor JSON.
# env/header values (e.g. "${LINEAR_TOKEN}") pass through verbatim.
PREFIX aide: <https://fastverk.dev/ontology/agentic_ide/projection#>

CONSTRUCT {
    aide:out_claude_mcp a aide:OutputFile ;
        aide:targetPath ".mcp.json" ;
        aide:fileFormat aide:Json ;
        aide:jsonShape aide:McpConfig ;
        aide:forIde aide:ClaudeCode ;
        aide:mcpEntry ?entry .
    ?entry aide:serverName ?name ;
        aide:fromDef ?server ;
        aide:mcpFlavor ?flavor ;
        aide:transport ?transport ;
        aide:command ?command ;
        aide:url ?url ;
        aide:bazelLabel ?label ;
        aide:arg ?arg ;
        aide:envVar ?env ;
        aide:header ?header .
    ?arg aide:value ?argv ; aide:order ?argo .
    ?env aide:key ?envk ; aide:value ?envv .
    ?header aide:key ?hk ; aide:value ?hv .
}
WHERE {
    ?server a aide:McpServer ;
        aide:defName ?name .
    BIND(IRI(CONCAT("https://fastverk.dev/ontology/agentic_ide/projection#entry/claude/mcp/", ?name)) AS ?entry)
    OPTIONAL { ?server aide:mcpFlavor ?flavor }
    OPTIONAL { ?server aide:transport ?transport }
    OPTIONAL { ?server aide:command ?command }
    OPTIONAL { ?server aide:url ?url }
    OPTIONAL { ?server aide:bazelLabel ?label }
    OPTIONAL {
        ?server aide:arg ?arg .
        ?arg aide:value ?argv .
        OPTIONAL { ?arg aide:order ?argo }
    }
    OPTIONAL {
        ?server aide:envVar ?env .
        ?env aide:key ?envk ; aide:value ?envv .
    }
    OPTIONAL {
        ?server aide:header ?header .
        ?header aide:key ?hk ; aide:value ?hv .
    }
}
