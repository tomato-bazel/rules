load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files(["defs.bzl"])

# Loadable for stardoc. (rules_mdbook's :defs_bzl isn't externally visible, so
# we don't list it as a dep; the load is exercised when a consumer expands
# tomato_mdbook — e.g. fastverk/docs.)
bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
)
