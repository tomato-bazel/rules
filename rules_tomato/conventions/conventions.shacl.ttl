# The tomato-bazel convention contract: the shape every rules module must satisfy.
# Validate the ecosystem RDF projection (tools/graph/graph.py -> ecosystem.ttl)
# against this with SHACL (pyshacl in CI, or rules_jena's validator in-Bazel) — the
# machine-checkable gate that turns "follow the conventions" into a CI pass/fail.
#
# Two tiers, by sh:severity:
#   * ENFORCED (sh:Violation, the default) — README + LICENSE + CHANGELOG. Achievable
#     today (backfilled across the tomato rules); this is the hard gate.
#   * ADVISORY (sh:Warning) — docs/ + examples/. Tracked + reported, non-blocking until
#     backfilled per repo. Run pyshacl with `--allow-warnings` so only Violations fail;
#     promote these to Violation once every targeted repo ships them.
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix fv:  <https://tomato-bazel.dev/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fv:RulesModuleShape a sh:NodeShape ;
    sh:targetClass fv:RulesModule ;   # rules_* only — products/brand aren't held to this

    # ---- ENFORCED baseline (sh:Violation) ----
    sh:property [ sh:path fv:has_README   ; sh:hasValue true ;
                  sh:message "every rules module must ship a README.md" ] ;
    sh:property [ sh:path fv:has_LICENSE   ; sh:hasValue true ;
                  sh:message "every rules module must ship a LICENSE" ] ;
    sh:property [ sh:path fv:has_CHANGELOG ; sh:hasValue true ;
                  sh:message "every rules module must ship a CHANGELOG.md" ] ;

    # ---- ADVISORY, aspirational (sh:Warning) ----
    sh:property [ sh:path fv:has_docs      ; sh:hasValue true ; sh:severity sh:Warning ;
                  sh:message "rules module should ship docs/ (stardoc)" ] ;
    sh:property [ sh:path fv:has_examples  ; sh:hasValue true ; sh:severity sh:Warning ;
                  sh:message "rules module should ship examples/" ] .
