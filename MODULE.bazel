# Kubernetes CRDs as build artifacts: controller-gen as a real hermetic action
# (no host Go, no `go list`, no `bazel query`), plus manifest adopt/bundle/validate
# and operator images.
module(
    name = "rules_k8s",
    version = "0.0.2",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")

# aspect_bazel_lib is a real (non-dev) dep: consumers pair `k8s_crd_library`
# with `write_source_files` to keep the committed CRD trees in lockstep.
#
# 2.22.5 exactly — an older transitive pin registers a zstd toolchain using a
# rule() kwarg removed in modern Bazel. Check your consumers before floating it.
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

# ── Go: needed to LOAD //crd, not just to build it ───────────────────────────
#
# rules_go is a real dep, and it was a dev_dependency until the first consumer
# proved that impossible.
#
# //crd/private/crd_library.bzl does
#   load("@rules_go//go/tools/gopackagesdriver:aspect.bzl", "go_pkg_info_aspect")
# because the aspect must be attached to an attr at RULE-DEFINITION time. A
# dev_dependency isn't visible to consumers, so anyone loading //crd:defs.bzl got:
#
#   No repository visible as '@rules_go' from repository '@@rules_k8s+'
#
# Loads are static and resolved when the .bzl is evaluated; there is no lazy or
# conditional load in Starlark. So the dep is load-bearing for every consumer of
# //crd, whether or not they build Go.
#
# THE COST, stated honestly: rules_go's own MODULE.bazel does
# `register_toolchains("@go_toolchains//:all")` (not dev), so every rules_k8s
# consumer gets Go toolchains registered. The SDK itself is only *fetched* if a Go
# action actually runs — a consumer that never builds Go pays module resolution,
# not a download.
#
# If that ever becomes a real cost for a consumer that only reads CRD schemas, the
# fix is to split //k8s into its own Go-free module. Don't do it speculatively —
# a split means sharing providers across modules, which tends to end in the second
# module copying the first's contract rather than importing it.
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.51.0")
# rules_github: the kubeconform release binary. rules_shell: the system-kubectl
# wrapper (//kubectl). Both are real deps — a consumer running k8s_validate or
# k8s_diff needs them.
bazel_dep(name = "rules_github", version = "0.1.2")

# k8s_operator_image (//oci). Pinned to the versions the fleet already runs
# so consumers of this module share the bzlmod cache.
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "stardoc", version = "0.7.2", dev_dependency = True)

# Pin the SDK your consumers already use, so the bzlmod cache is shared.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.4")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "io_k8s_apimachinery",  # //examples/smoke's API types
    "io_k8s_sigs_controller_tools",  # the CRD generator, driven as a library
    "io_k8s_sigs_yaml",
    "org_golang_x_tools",  # go/packages — the driver protocol
)

# NOT register_toolchains(). Registering here would propagate the Go CRD
# toolchain into every consumer's graph, which is the thing the dev_dependency
# split above exists to prevent. rules_k8s registers it for its OWN build in
# //.bazelrc via --extra_toolchains; consumers do the same in theirs.

# kubeconform, sha256-pinned per platform (//validate/repositories.bzl).
kubeconform = use_extension("//validate:extensions.bzl", "kubeconform")
use_repo(kubeconform, "kubeconform")

# The default operator base image, pinned by digest. Every operator in the fleet
# An operator is a static binary, so distroless/static suffices. Pinned by DIGEST:
# a mutable tag like `nonroot` is not reproducible, and this rule does not offer
# that option.
# NAMESPACED. A module extension's repos are shared across the whole module graph,
# so `oci.pull(name = "distroless_static")` here collides with any consumer that
# pulls a base of that name — and most operator repos do:
#
#   A repo named distroless_static_linux_amd64 is already generated by this
#   module extension
#
# Found by the first real consumer, immediately after publishing 0.0.1. Same class
# of bug as a bare `//tools/oci:base_image` label in a shared macro: a module
# assuming it is the only one in the graph.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "rules_k8s_distroless_static",
    digest = "sha256:c0f429e16b13e583da7e5a6ec20dd656d325d88e6819cafe0adb0828976529dc",
    image = "gcr.io/distroless/static",
    platforms = ["linux/amd64"],
)
use_repo(oci, "rules_k8s_distroless_static", "rules_k8s_distroless_static_linux_amd64")
