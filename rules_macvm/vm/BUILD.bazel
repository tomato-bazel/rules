load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

# Resolved by the `vm` rule when no explicit `provider` is set. Register
# a backend with `register_toolchains("@vfkit//:vfkit_toolchain_def")`.
toolchain_type(name = "toolchain_type")

exports_files([
    "defs.bzl",
    "providers.bzl",
    "toolchains.bzl",
])

bzl_library(
    name = "providers_bzl",
    srcs = ["providers.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "toolchains_bzl",
    srcs = ["toolchains.bzl"],
    visibility = ["//visibility:public"],
    deps = [":providers_bzl"],
)

bzl_library(
    name = "defs_bzl",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":providers_bzl",
        "//vm/private:argv_bzl",
    ],
)
