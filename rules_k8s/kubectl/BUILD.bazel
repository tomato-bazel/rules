load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//kubectl:toolchains.bzl", "kubectl_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files(["toolchains.bzl"])

toolchain_type(name = "toolchain_type")

sh_binary(
    name = "system_kubectl",
    srcs = ["system_kubectl.sh"],
)

kubectl_toolchain(
    name = "default_kubectl_toolchain_impl",
    kubectl = ":system_kubectl",
)

toolchain(
    name = "default_kubectl_toolchain",
    toolchain = ":default_kubectl_toolchain_impl",
    toolchain_type = ":toolchain_type",
)

bzl_library(
    name = "toolchains",
    srcs = ["toolchains.bzl"],
)
